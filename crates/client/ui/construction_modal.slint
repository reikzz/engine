import { Theme } from "theme.slint";
import { ChassisFrame, TacticalButton, SectionHeader } from "tactical_widgets.slint";

export struct ConstructionRecipeItem {
    id: int,
    key: string,
    name: string,
    sector: string,
    build_time_days: int,
    cost_text: string,
    materials_text: string,
    tech_unlocked: bool,
    required_tech_name: string,
}

export component ConstructionModal inherits Rectangle {
    in property <string> target_region_name: "Northern Region";
    in property <int> target_region_id: 1;
    in property <[ConstructionRecipeItem]> recipes: [];
    in property <int> active_category_filter: 0;

    callback close_clicked();
    callback category_selected(int);
    callback commission_recipe(int);

    background: #000000c0;

    TouchArea {
        clicked => {}
    }

    ChassisFrame {
        width: 820px;
        height: 580px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        is_accented: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            HorizontalLayout {
                height: 38px;
                alignment: center;
                spacing: 12px;

                Rectangle {
                    width: 4px;
                    height: 28px;
                    background: Theme.accent_gold;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;

                    Text {
                        text: "STATE INDUSTRIAL PLANNING // COMMISSION FACILITY";
                        color: Theme.text_primary;
                        font-size: 14px;
                        font-weight: 800;
                        letter-spacing: 1px;
                    }

                    Text {
                        text: "TARGET: " + root.target_region_name + " (REGION #" + root.target_region_id + ")";
                        color: Theme.text_amber;
                        font-size: 10px;
                        font-weight: 700;
                    }
                }

                TacticalButton {
                    width: 32px;
                    height: 30px;
                    text: "✕";
                    is_danger: true;
                    clicked => { root.close_clicked(); }
                }
            }

            HorizontalLayout {
                height: 28px;
                spacing: 6px;

                TacticalButton {
                    horizontal-stretch: 1;
                    height: 28px;
                    text: "ALL SECTORS";
                    is_active: root.active_category_filter == 0;
                    clicked => { root.category_selected(0); }
                }

                TacticalButton {
                    horizontal-stretch: 1;
                    height: 28px;
                    text: "EXTRACTION";
                    is_active: root.active_category_filter == 1;
                    clicked => { root.category_selected(1); }
                }

                TacticalButton {
                    horizontal-stretch: 1;
                    height: 28px;
                    text: "MANUFACTURING";
                    is_active: root.active_category_filter == 2;
                    clicked => { root.category_selected(2); }
                }

                TacticalButton {
                    horizontal-stretch: 1;
                    height: 28px;
                    text: "HIGH-TECH & IT";
                    is_active: root.active_category_filter == 3;
                    clicked => { root.category_selected(3); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.border_inner;
            }

            Flickable {
                content-height: root.recipes.length * 74px;

                VerticalLayout {
                    spacing: 6px;

                    for recipe in root.recipes : Rectangle {
                        height: 68px;
                        background: Theme.surface_card;
                        border-width: 1px;
                        border-color: Theme.border_outer;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 12px;
                            alignment: center;

                            Rectangle {
                                width: 3px;
                                background: recipe.tech_unlocked ? Theme.accent_gold : Theme.accent_crimson;
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 3px;
                                alignment: center;

                                HorizontalLayout {
                                    spacing: 8px;

                                    Text {
                                        text: recipe.name;
                                        color: recipe.tech_unlocked ? Theme.text_primary : Theme.text_muted;
                                        font-size: 13px;
                                        font-weight: 800;
                                    }

                                    Rectangle {
                                        border-radius: Theme.radius_sharp;
                                        background: Theme.surface_inset;
                                        border-width: 1px;
                                        border-color: Theme.border_inner;
                                        height: 18px;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;

                                            Text {
                                                text: recipe.sector;
                                                color: Theme.text_cyan;
                                                font-size: 9px;
                                                font-weight: 700;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;

                                    Text {
                                        text: "EST. TIME: " + recipe.build_time_days + " DAYS";
                                        color: Theme.text_secondary;
                                        font-size: 10px;
                                    }

                                    Text {
                                        text: "MATERIALS: " + recipe.materials_text;
                                        color: Theme.text_muted;
                                        font-size: 10px;
                                    }
                                }
                            }

                            if !recipe.tech_unlocked : VerticalLayout {
                                alignment: center;
                                width: 150px;

                                Text {
                                    text: "LOCKED TECH:";
                                    color: Theme.accent_crimson;
                                    font-size: 9px;
                                    font-weight: 800;
                                    horizontal-alignment: right;
                                }

                                Text {
                                    text: recipe.required_tech_name;
                                    color: Theme.text_muted;
                                    font-size: 9px;
                                    horizontal-alignment: right;
                                }
                            }

                            if recipe.tech_unlocked : TacticalButton {
                                width: 140px;
                                height: 36px;
                                text: "COMMISSION";
                                is_active: true;
                                clicked => { root.commission_recipe(recipe.id); }
                            }
                        }
                    }
                }
            }
        }
    }
}
